---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, url } from '../lib/url';
import { analytics } from '../lib/analytics';

interface Props { title: string; description: string; current?: string; }
const { title, description, current = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(asset('og.png'), Astro.site).href;
const weights = [['Light', 300], ['Regular', 400], ['Medium', 500], ['Semibold', 600]] as const;
const fontFaces = weights.map(([name, w]) =>
  `@font-face{font-family:'Graphik';font-weight:${w};font-style:normal;font-display:swap;src:url('${asset(`fonts/Graphik-${name}.woff2`)}') format('woff2')}`).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Review build: not for indexing. Flipped at launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Trisian" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <link rel="preload" href={asset('fonts/Graphik-Light.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset('fonts/Graphik-Semibold.woff2')} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
    {analytics.domain && <script is:inline defer data-domain={analytics.domain} src={analytics.script}></script>}
    <script is:inline>
      // Arm entrances only when script runs; a timer in motion.ts releases anything that has not started.
      document.documentElement.classList.add('js');
      try { if (localStorage.getItem('trisian-motion') === 'paused') document.documentElement.classList.add('motion-paused'); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
