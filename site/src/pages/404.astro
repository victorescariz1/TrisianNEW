---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/url';
---
<Base title="Page not found · Trisian" description="That page isn’t here. Everything else is.">
  <section class="notfound wrap" data-ground="morning">
    <h1 class="t-display assemble">
      <span class="line"><span style="--i:0">That page</span></span>
      <span class="line"><span style="--i:1"><span class="ink" style="--i:1">isn’t here</span>.</span></span>
    </h1>
    <p class="t-lede">Everything else is.</p>
    <ul>
      <li><a class="link" href={url()}>Home</a></li>
      <li><a class="link" href={url('safe-workspace')}>Safe Workspace</a></li>
      <li><a class="link" href={url('plans')}>Plans</a></li>
      <li><a class="link" href={url('start')}>Request your assessment</a></li>
    </ul>
  </section>
</Base>
