---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Closing from '../components/Closing.astro';
import Invoice from '../components/Invoice.astro';
import PlanLadder from '../components/PlanLadder.astro';
import '../styles/home.css';
import '../styles/pages.css';
import { url } from '../lib/url';
import { plansPage as c, projectsPage } from '../content/pages';
import plans from '../data/plans.json';
const stateMark: Record<string, string> = { in: '●', addon: '○', project: '◇', no: '·' };
const states = plans.states as Record<string, string>;
---
<Base title={c.title} description={c.description} current="plans">
  <PageHero eyebrow="Plans" lines={c.lines} ink={c.ink} lede={c.lede} />

  <section class="band" data-ground="noon" aria-labelledby="compare-h">
    <div class="wrap">
      <h2 class="sr-only" id="compare-h">The three plans compared</h2>
      <PlanLadder />
      <h2 class="t-h2 matrix__h" id="compare">Compare all plans</h2>
      <div class="compare">
        <table>
          <caption class="sr-only">What each plan includes</caption>
          <thead><tr><th scope="col">Line by line</th>{plans.plans.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
          <tbody>
            <tr><th scope="row">Microsoft 365 license</th>{plans.plans.map((p) => <td>{p.license.replace('Microsoft 365 ', '')}</td>)}</tr>
            <tr><th scope="row">Users</th>{plans.plans.map((p) => <td>{p.users.replace(' users', '')}</td>)}</tr>
            <tr><th scope="row">Support</th>{plans.plans.map((p) => <td>{p.support}</td>)}</tr>
            <tr><th scope="row">Frameworks our controls support</th>{plans.plans.map((p) => <td>{p.frameworks.length ? `${p.frameworksNote ? 'Those of Advanced, plus ' : ''}${p.frameworks.join(', ')}` : <><span class="mark" aria-hidden="true">·</span> {states.no}</>}</td>)}</tr>
            {plans.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {plans.plans.map((p) => {
                  const state = (row as Record<string, string>)[p.id];
                  return <td data-state={state}><span class="mark" aria-hidden="true">{stateMark[state]}</span> <span class="state">{states[state]}</span></td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="legend" aria-hidden="true">{Object.entries(states).map(([k, v]) => <span>{stateMark[k]} {v}</span>)}</p>
      <p class="t-small measure" style="margin-top: var(--s-5)">Security and compliance features in each Microsoft 365 license are as published by Microsoft, and Microsoft may change them.</p>
    </div>
  </section>

  <section class="band" data-ground="morning" aria-labelledby="invoice-h">
    <div class="wrap band__grid band__grid--aside">
      <div class="band__head">
        <p class="t-question">{c.invoice.question}</p>
        <h2 class="t-h1" id="invoice-h"><span class="ink">{c.invoice.answer}</span></h2>
      </div>
      <div class="band__body" data-enter="open">
        <Invoice />
      </div>
      <div class="band__aside">
        <h3 class="t-h3" id="around-h">{c.around.heading}</h3>
        <ul class="invoice invoice--stack">
          {c.around.items.map((item) => <li><strong>{item.name}</strong><span>{item.body}</span></li>)}
        </ul>
        <p><a class="link" href={url('projects')}>The kinds of project <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="band" id="projects" data-ground="noon" aria-labelledby="services-h">
    <div class="wrap band__grid">
      <div class="band__head">
        <h2 class="t-h2" id="services-h">{c.services.heading}</h2>
        <p class="t-lede">{c.services.lede}</p>
      </div>
      <div class="band__body">
        <p class="t-h3">{projectsPage.kinds.areas.map((area) => area.name).join(' · ')}</p>
        <p class="t-small">{c.services.note}</p>
        <p><a class="link" href={url('projects')}>See the projects in each area <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="band" data-ground="morning" aria-labelledby="questions-h">
    <div class="wrap">
      <h2 class="sr-only" id="questions-h">Questions</h2>
      <ul class="qa">
        <li>
          <p class="t-question">{c.price.question}</p>
          <div class="qa__answer"><p class="t-h2">{c.price.body}</p></div>
        </li>
        {c.questions.map((q) => (
          <li>
            <p class="t-question">{q.question}</p>
            <div class="qa__answer"><p class="t-h2"><span class="ink">{q.answer}</span></p><p class="t-lede measure">{q.body}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Closing />
</Base>
