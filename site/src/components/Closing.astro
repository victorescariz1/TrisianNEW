---
// The closing band on every page but Start: the invitation, in dawn light.
import Photo from './Photo.astro';
import { url } from '../lib/url';
---
<section class="closing" data-ground="gold" aria-labelledby="closing-h">
  <div class="closing__light"><Photo slot="band-dawn" decorative /></div>
  <div class="wrap closing__inner">
    <h2 class="t-h1" id="closing-h">Ask us the <span class="ink">hard question</span> first.</h2>
    <div class="actions">
      <a class="btn" href={url('start')}>Request your assessment <span class="arrow" aria-hidden="true">→</span></a>
      <a class="link" href="mailto:contact@trisian.com">contact@trisian.com</a>
    </div>
  </div>
</section>
