---
import { asset, url } from '../lib/url';
interface Props { current?: string; }
const { current = '' } = Astro.props;
const nav = [
  { href: url('safe-workspace'), label: 'Safe Workspace', id: 'safe-workspace' },
  { href: url('plans'), label: 'Plans', id: 'plans' },
  { href: url('who-its-for'), label: 'Who it’s for', id: 'who-its-for' },
  { href: url('trust'), label: 'Trust', id: 'trust' },
  { href: url('company'), label: 'Company', id: 'company' },
];
---
<header class="site-header" data-header>
  <div class="wrap">
    <a class="wordmark" href={url()} aria-label="Trisian, home">
      <img src={asset('brand/trisian-logo.svg')} alt="Trisian" width="904" height="200" />
    </a>
    <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn" href={url('start')}>Request your assessment</a>
    </nav>
  </div>
</header>
