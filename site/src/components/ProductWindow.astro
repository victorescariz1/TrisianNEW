---
// The Safe Workspace desktop, drawn in HTML and CSS so it is sharp at any size and can move.
// It reads as "a Windows desktop" without reproducing Microsoft artwork. Content is fictional.
interface Props { signin?: string[]; class?: string; compact?: boolean; }
const { signin = [], class: cls = '', compact = false } = Astro.props;
---
<div class:list={['pw', { 'pw--compact': compact }, cls]} role="img" aria-label="Illustration: a Safe Workspace desktop after sign-in, with a spreadsheet and mail open.">
  <div class="pw__screen" aria-hidden="true">
    <div class="pw__wallpaper"></div>
    <div class="pw__doc">
      <div class="pw__bar"><span>Forecast.xlsx</span><i></i><i></i><i></i></div>
      <div class="pw__cells">
        {['Region', 'Q3', 'Q4', 'North', '412', '448', 'South', '389', '401', 'West', '276', '312', 'Total', '1,077', '1,161'].map((c, i) => (
          <span class:list={{ 'is-head': i < 3 || i % 3 === 0, 'is-total': i >= 12 }}>{c}</span>
        ))}
      </div>
    </div>
    {!compact && (
      <div class="pw__mail">
        <div class="pw__bar"><span>Inbox</span></div>
        <ul>
          <li><b>Budget review</b><span>Thursday, 10:00</span></li>
          <li><b>Client onboarding pack</b><span>Ready for your sign-off</span></li>
          <li><b>Team lunch</b><span>Friday</span></li>
        </ul>
      </div>
    )}
    <div class="pw__taskbar"><i class="pw__start"></i><i></i><i></i><i></i><i></i><i></i><span>8:02 AM</span></div>
    {signin.length > 0 && (
      <ol class="pw__signin">
        {signin.map((s, i) => <li style={`--n:${i}`}>{s}</li>)}
      </ol>
    )}
  </div>
</div>

<style>
  .pw { background: #fff; border-radius: var(--r-inset); box-shadow: var(--shadow-window); padding: 8px; container-type: inline-size; }
  .pw__screen { position: relative; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: #DCE6F7; font-size: clamp(8px, 2.3cqi, 13px); line-height: 1.35; color: var(--ink); }
  .pw__wallpaper { position: absolute; inset: 0; background: linear-gradient(160deg, #EAF0FB 0%, #D5E0F5 55%, #C7D4F0 100%); }
  .pw__wallpaper::after { content: ''; position: absolute; left: -10%; right: 30%; top: 38%; bottom: -30%; border-radius: 50%; background: #F6F1E7; opacity: .7; filter: blur(18px); }
  .pw__doc, .pw__mail { position: absolute; background: #fff; border-radius: 6px; box-shadow: 0 1px 2px rgb(11 16 48 / .08), 0 10px 24px -10px rgb(11 16 48 / .22); overflow: hidden; }
  .pw__doc { left: 5%; top: 9%; width: 58%; }
  .pw--compact .pw__doc { left: 8%; right: 8%; width: auto; top: 12%; }
  .pw__mail { right: 5%; top: 24%; width: 36%; }
  .pw__bar { display: flex; align-items: center; gap: 5px; padding: 6px 9px; background: #F4F5F9; border-bottom: 1px solid #E7E9F1; font-weight: 500; }
  .pw__bar span { margin-right: auto; }
  .pw__bar i { width: 7px; height: 7px; border-radius: 50%; background: #D4D7E3; }
  .pw__cells { display: grid; grid-template-columns: 1.4fr 1fr 1fr; }
  .pw__cells span { padding: 5px 9px; border-bottom: 1px solid #EEF0F5; border-right: 1px solid #EEF0F5; font-variant-numeric: tabular-nums; }
  .pw__cells .is-head { font-weight: 500; color: var(--ink-2); }
  .pw__cells .is-total { font-weight: 600; background: var(--tint-1); color: var(--cobalt); }
  .pw__mail ul { padding: 4px 0; }
  .pw__mail li { display: grid; padding: 5px 9px; border-bottom: 1px solid #EEF0F5; }
  .pw__mail li:last-child { border: 0; }
  .pw__mail b { font-weight: 500; }
  .pw__mail span { color: var(--ink-3); }
  .pw__taskbar { position: absolute; left: 50%; bottom: 3.5%; transform: translateX(-50%); display: flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 9px; background: rgb(255 255 255 / .82); box-shadow: 0 1px 2px rgb(11 16 48 / .1); }
  .pw__taskbar i { width: 1.35em; height: 1.35em; border-radius: 4px; background: #C9D2EA; }
  .pw__taskbar i:nth-of-type(2) { background: var(--cobalt); }
  .pw__taskbar i:nth-of-type(3) { background: #7C8FE8; }
  .pw__taskbar i:nth-of-type(4) { background: #E6B872; }
  .pw__taskbar .pw__start { background: conic-gradient(from 0deg, var(--cobalt) 0 25%, #4D7CFF 0 50%, #7C8FE8 0 75%, #A9B6F2 0); border-radius: 3px; }
  .pw__taskbar span { margin-left: 8px; color: var(--ink-2); font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* On a small window there is room for one thing: the document. */
  @container (max-width: 400px) {
    .pw__mail { display: none; }
    .pw__doc { left: 6%; right: 6%; width: auto; }
  }
  /* A small compact window: the rows tighten, so the document ends above the taskbar. */
  @container (max-width: 302px) {
    .pw--compact .pw__doc { top: 8%; }
    .pw--compact .pw__bar { padding-block: 4px; }
    .pw--compact .pw__cells span { padding-block: 3px; }
  }
  /* Smaller still, it is a thumbnail: type and spacing scale with the window, so nothing collides. */
  @container (max-width: 246px) {
    .pw--compact .pw__screen { font-size: 3.1cqi; }
    .pw--compact .pw__bar { padding: .5em 1.1em; gap: .6em; }
    .pw--compact .pw__bar i { width: .85em; height: .85em; }
    .pw--compact .pw__cells span { padding: .375em 1.1em; }
    .pw--compact .pw__taskbar { gap: .75em; padding: .6em 1.2em; }
    .pw--compact .pw__taskbar span { margin-left: 1em; }
  }
  .pw__signin { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .pw__signin li { position: absolute; left: 50%; bottom: 17%; translate: -50% 0; width: max-content; max-width: 86%; padding: 6px 12px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 500; text-align: center; opacity: 0; }
  .pw__signin li:last-child { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    /* The opening: sign in, the desktop settles, the profile arrives. Plays once, from first paint, and is
       over in under five seconds (four lines: the last one lands at about 4.6 s and stays). */
    .pw__signin li { animation: say 1300ms var(--ease) both; animation-delay: calc(var(--n) * 1080ms + 300ms); }
    .pw__signin li:last-child { animation-name: say-stay; animation-duration: 1050ms; }
    .pw__doc { animation: settle var(--d-3) var(--ease) 1250ms both; }
    .pw__mail { animation: settle var(--d-3) var(--ease) 2400ms both; }
    .pw__taskbar { animation: settle-bar var(--d-3) var(--ease) 1080ms both; }
    @keyframes say { 0% { opacity: 0; translate: -50% 8px; } 15%, 80% { opacity: 1; translate: -50% 0; } 100% { opacity: 0; translate: -50% -6px; } }
    @keyframes say-stay { 0% { opacity: 0; translate: -50% 8px; } 100% { opacity: 1; translate: -50% 0; } }
    @keyframes settle { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: none; } }
    @keyframes settle-bar { from { opacity: 0; transform: translate(-50%, 8px); } to { opacity: 1; transform: translateX(-50%); } }
  }
</style>
